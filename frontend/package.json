{
  "name": "ai-studio-applet",
  "version": "0.1.0",
  "description": "PomoPet desktop Pomodoro app with an AI pet companion",
  "author": "PomoPet contributors",
  "private": true,
  "main": "main.js",
  "scripts": {
    "dev": "next dev --turbo",
    "dev:backend": "conda run --no-capture-output -n pomopet python -m uvicorn app.main:app --app-dir ../backend --reload --reload-dir ../backend",
    "dev:electron": "wait-on http://localhost:3000 && electron . --dev",
    "dev:all": "concurrently --kill-others --success first --names API,NEXT,ELECTRON --prefix-colors cyan,blue,magenta \"npm run dev:backend\" \"npm run dev\" \"npm run dev:electron\"",
    "build": "next build && node scripts/apply-csp.mjs",
    "build:backend": "powershell -NoProfile -ExecutionPolicy Bypass -File ../scripts/build-backend.ps1",
    "build:native": "npm run package",
    "package": "npm run build && npm run build:backend && electron-builder --dir",
    "dist": "npm run build && npm run build:backend && electron-builder --win nsis",
    "start": "next start",
    "start:native": "electron .",
    "dev:native": "concurrently --kill-others --success first --names NEXT,ELECTRON --prefix-colors blue,magenta \"npm run dev\" \"npm run dev:electron\"",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/*.test.mjs",
    "lint": "eslint .",
    "clean": "next clean"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "get-windows": "^9.3.0",
    "lucide-react": "^0.553.0",
    "motion": "^12.23.24",
    "next": "15.5.28",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.11",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.21",
    "concurrently": "^8.2.2",
    "electron": "^33.0.0",
    "electron-builder": "^26.0.12",
    "eslint": "9.39.1",
    "eslint-config-next": "15.5.28",
    "postcss": "^8.5.6",
    "tailwindcss": "4.1.11",
    "typescript": "5.9.3",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.pomopet.desktop",
    "productName": "PomoPet",
    "asar": true,
    "npmRebuild": false,
    "directories": {
      "output": "../dist"
    },
    "files": [
      "out/**/*",
      "electron/**/*",
      "main.js",
      "preload.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../backend/dist/pomopet-backend.exe",
        "to": "backend/pomopet-backend.exe"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
